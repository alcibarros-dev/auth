<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.authcore.exemplo</groupId>
        <artifactId>exemplo-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!-- Regra de negócio: as notas de cada usuário. Recebe o usuário pronto (@CurrentUser); não conhece JWT nem as
         contas. -->
    <artifactId>exemplo-notas</artifactId>
    <name>exemplo-notas</name>

    <dependencies>
        <dependency>
            <groupId>br.com.authcore</groupId>
            <artifactId>auth-security-api</artifactId>
        </dependency>
        <!-- ApiException: erros de negócio no mesmo formato problem+json dos erros de segurança -->
        <dependency>
            <groupId>br.com.authcore</groupId>
            <artifactId>auth-support</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- Só as anotações de documentação (@Operation, @SecurityRequirement) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
